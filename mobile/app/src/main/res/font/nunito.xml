<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Nunito font family placeholders.
        Please add the actual TTF files into
        `mobile/app/src/main/res/font/` with these names:
        - nunito_regular.ttf
        - nunito_bold.ttf

        You can download Nunito from Google Fonts and place the .ttf files.
    -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/nunito_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/nunito_bold" />
</font-family>
