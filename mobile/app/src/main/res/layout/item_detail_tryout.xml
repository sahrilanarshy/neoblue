<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/icon_subtes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_blue_light">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/neo_blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_nama_subtes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/icon_subtes"
            android:text="Literasi Bahasa Indonesia"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_subtes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nama_subtes"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/icon_subtes"
            android:text="3 soal · 39 menit"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_kerjakan_soal"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_below="@id/icon_subtes"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/neo_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Kerjakan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>