<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp"
    app:contentPadding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/tv_judul_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Judul Notifikasi"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_tanggal_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2023-10-27"
                android:textSize="12sp"
                android:textColor="@color/text_grey"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_isi_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Isi notifikasi akan muncul di sini secara lengkap."
                android:textColor="@color/text_dark"
                android:layout_marginTop="8dp"/>
                
            <TextView
                android:id="@+id/tv_link_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buka Link"
                android:textColor="@color/neo_blue"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_delete_notif"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center|end"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:src="@drawable/ic_delete"
            android:contentDescription="Hapus notifikasi"
            android:tint="@color/text_dark"/>

    </FrameLayout>
</androidx.cardview.widget.CardView>