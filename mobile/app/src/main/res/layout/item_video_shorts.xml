<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/layout_info_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#80000000">

        <TextView
            android:id="@+id/tv_title_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Video Shorts"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tv_desc_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi singkat video..."
            android:textColor="@color/white"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Upgrade card shown at end for Free users (full-screen centered) -->
    <FrameLayout
        android:id="@+id/layout_upgrade_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black">

        <LinearLayout
            android:id="@+id/layout_upgrade_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_upgrade_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upgrade ke Premium untuk menonton\nlebih banyak."
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <Button
                android:id="@+id/btn_upgrade_action"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_upgrade"
                android:text="Upgrade Sekarang"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <Button
                android:id="@+id/btn_upgrade_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="Batal"
                android:textColor="#CCCCCC"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>
</FrameLayout>