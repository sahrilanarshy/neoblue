<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <TextView
            android:text="Jadwal Belajar"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="+ Tambah Jadwal Baru"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <TextView android:text="Hari" style="@style/LabelInput"/>
                <Spinner
                    android:id="@+id/spinner_hari"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_spinner_border"
                    android:layout_marginBottom="12dp"/>

                <TextView android:text="Mata Pelajaran" style="@style/LabelInput"/>
                <Spinner
                    android:id="@+id/spinner_mapel"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_spinner_border"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView android:text="Jam Mulai" style="@style/LabelInput"/>
                        <Spinner
                            android:id="@+id/spinner_jam_mulai"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_spinner_border"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView android:text="Jam Selesai" style="@style/LabelInput"/>
                        <Spinner
                            android:id="@+id/spinner_jam_selesai"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_spinner_border"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tambah_jadwal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+  Tambah Jadwal"
                    android:textColor="@color/text_grey"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:text="Jadwal Saat Ini"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- RecyclerView untuk Menampilkan Daftar Jadwal -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_jadwal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="24dp" />

        <TextView
            android:text="Ringkasan Mingguan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="2dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="16dp">

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Senin" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_senin_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selasa" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_selasa_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rabu" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_rabu_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kamis" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_kamis_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jumat" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_jumat_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

                <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_marginBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sabtu" android:textColor="@color/text_grey" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/summary_sabtu_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada jadwal"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="4dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />
                </LinearLayout>

            </GridLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>