<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="56dp">

        <include layout="@layout/layout_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_blue_card_top"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:text="Upgrade ke Premium"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Maksimalkan persiapan UTBK - SNBT\ndengan fitur Premium Lengkap"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Promo Terbatas!"
                        android:background="@drawable/bg_promo_badge"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:textColor="#5D4037"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_paket_nama"
                            android:text="Paket Premium 1"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tv_paket_harga"
                            android:text="Rp 200.000"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/neo_red"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Berlaku untuk Paket Premium 1"
                            android:textColor="@color/text_grey"
                            android:layout_marginBottom="16dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:id="@+id/container_fitur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <!-- List Fitur Dinamis akan dimasukkan di sini -->
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:text="Detail Pembayaran"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_marginBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                            <TextView android:id="@+id/tv_detail_paket_nama" android:text="Paket Premium" android:textColor="@color/text_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_detail_paket_harga" android:text="Rp 200.000" android:textColor="@color/text_dark" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </RelativeLayout>

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <TextView android:text="Promo" android:textColor="@color/text_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="- Rp 0" android:textColor="@color/neo_green" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </RelativeLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="16dp"/>

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                            <TextView android:text="Total" android:textStyle="bold" android:textColor="@color/black" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_total_harga" android:text="Rp 200.000" android:textStyle="bold" android:textColor="@color/neo_red" android:textSize="20sp" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </RelativeLayout>

                        <Button
                            android:id="@+id/btn_langganan"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:text="Langganan Sekarang"
                            android:backgroundTint="@color/neo_blue"
                            android:textColor="@color/white"
                            android:textStyle="bold"/>

                        <TextView
                            android:text="Dengan melakukan pembayaran, anda menyetujui syarat dan ketentuan yang berlaku."
                            android:textSize="10sp"
                            android:textColor="@color/text_grey"
                            android:gravity="center"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:text="Perbandingan Fitur"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_marginBottom="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content"/> <TextView android:text="Gratis" android:textStyle="bold" android:textColor="@color/text_dark" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                            <TextView android:text="Premium" android:textStyle="bold" android:textColor="@color/text_dark" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp">
                            <TextView android:text="Materi\nPembelajaran" android:paddingStart="16dp" android:textColor="@color/black" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"/>
                            <TextView android:text="3 Subtest" android:textColor="@color/text_grey" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                            <TextView android:text="Semua Subtest" android:background="@color/bg_premium_light" android:textStyle="bold" android:textColor="@color/neo_blue" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp">
                            <TextView android:text="Tryout" android:paddingStart="16dp" android:textColor="@color/black" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"/>
                            <TextView android:text="1 Per Bulan" android:textColor="@color/text_grey" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                            <TextView android:text="Unlimited" android:background="@color/bg_premium_light" android:textStyle="bold" android:textColor="@color/neo_blue" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp">
                            <TextView android:text="Komunitas" android:paddingStart="16dp" android:textColor="@color/black" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"/>
                            <TextView android:text="Whatsapp\nreguler" android:textColor="@color/text_grey" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                            <TextView android:text="Whatsapp\nPremium" android:background="@color/bg_premium_light" android:textStyle="bold" android:textColor="@color/neo_blue" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                        </LinearLayout>

                        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp">
                            <TextView android:text="Download Offline" android:paddingStart="16dp" android:textColor="@color/black" android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center">
                                <ImageView android:src="@android:drawable/ic_delete" app:tint="@color/neo_red" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@color/bg_premium_light">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_premium_check_checked"
                                    android:contentDescription="Centang fitur premium"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/neo_blue"
        app:itemTextColor="@color/text_dark"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"/>

</RelativeLayout>